# Your blog's domain (DNS must point to your reverse proxy)
DOMAIN=rewind.example.com

# Database passwords: a different random value for each (openssl rand -hex 24)
# MySQL only reads these the first time it creates data/mysql.
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Transactional email (sign-in links, signup confirmations) via SMTP.
# Use the SMTP credentials from your Mailgun sending domain.
# Newsletters are set up separately in Ghost admin › Settings › Email newsletter (Mailgun API key).
MAIL_FROM="Rewind <noreply@rewind.example.com>"
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@rewind.example.com
SMTP_PASS=change-me
