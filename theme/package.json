{
  "name": "rewind",
  "description": "A Ghost theme for feelings-first album reviews: no scores, just what an album transmits and the story behind it.",
  "version": "1.4.0",
  "engines": {
    "ghost": ">=5.0.0"
  },
  "license": "MIT",
  "author": {
    "name": "Afonso Muralha",
    "email": "author@example.com",
    "url": "https://afonsomuralha.com"
  },
  "keywords": [
    "ghost",
    "theme",
    "ghost-theme",
    "music",
    "reviews"
  ],
  "config": {
    "posts_per_page": 13,
    "image_sizes": {
      "xs": { "width": 160 },
      "s": { "width": 320 },
      "m": { "width": 600 },
      "l": { "width": 960 },
      "xl": { "width": 1400 }
    },
    "card_assets": true,
    "custom": {
      "show_welcome_banner": {
        "type": "boolean",
        "default": true,
        "group": "homepage"
      },
      "welcome_title": {
        "type": "text",
        "default": "Welcome to Rewind.",
        "group": "homepage"
      },
      "welcome_text": {
        "type": "text",
        "default": "Hi, I'm Afonso Muralha. An album is more than a number, so you won't find any scores here. Each review is about what an album transmits and how it can move you, told through my own story with it: when and how it found me, and the mark it left.",
        "group": "homepage"
      },
      "welcome_image": {
        "type": "image",
        "group": "homepage"
      },
      "welcome_button_label": {
        "type": "text",
        "default": "About me",
        "group": "homepage"
      },
      "welcome_button_link": {
        "type": "text",
        "default": "/about/",
        "group": "homepage"
      },
      "pixel_art_images": {
        "type": "boolean",
        "default": true,
        "description": "Keep the welcome image and About avatar crisp (for pixel art)"
      },
      "newsletter_title": {
        "type": "text",
        "default": "Get new reviews in your inbox."
      }
    }
  }
}
