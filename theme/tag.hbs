{{!< default}}

<section class="container archive-head">
    {{#tag}}
    <div class="archive-intro">
        <p class="kicker">{{#match slug "~^" "artist-"}}Artist{{else}}Tag{{/match}}</p>
        <h1 class="archive-title">{{name}}</h1>
        {{#if description}}<p class="archive-desc">{{description}}</p>{{/if}}
    </div>
    {{/tag}}
    <dl class="stats">
        <div><dt>Reviews</dt><dd>{{pagination.total}}</dd></div>
    </dl>
</section>

<section class="container archive-list" aria-label="Reviews">
    {{#match tag.slug "~^" "artist-"}}
        <ol class="rows">
            {{#foreach posts}}
                <li>
                    <a class="row" href="{{url}}">
                        <span class="row-cover" aria-hidden="true">
                            {{#if feature_image}}
                                <img src="{{img_url feature_image size="s"}}" alt="" loading="lazy">
                            {{else}}
                                <span class="cover-fallback"></span>
                            {{/if}}
                        </span>
                        <span class="row-body">
                            <span class="row-meta dot-list">{{> "genre-year"}}</span>
                            <span class="row-title">{{title}}</span>
                            <span class="row-excerpt">{{excerpt words="30"}}</span>
                        </span>
                        <span class="row-cta">Read review &rarr;</span>
                    </a>
                </li>
            {{/foreach}}
        </ol>
    {{else}}
        <div class="post-grid">
            {{#foreach posts}}
                {{> "post-card"}}
            {{/foreach}}
        </div>
    {{/match}}

    {{pagination}}
</section>
