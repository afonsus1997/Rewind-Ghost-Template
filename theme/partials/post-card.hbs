<article class="card {{post_class}}">
    <a class="card-cover" href="{{url}}" aria-label="Read the review of {{title}}">
        {{#if feature_image}}
            <img
                srcset="{{img_url feature_image size="s"}} 320w, {{img_url feature_image size="m"}} 600w"
                sizes="(max-width: 600px) 100vw, 300px"
                src="{{img_url feature_image size="m"}}"
                alt="" loading="lazy">
        {{else}}
            <span class="cover-fallback" aria-hidden="true"></span>
        {{/if}}
    </a>
    <div class="card-body">
        <h3 class="card-title"><a href="{{url}}">{{title}}</a></h3>
        <p class="card-artist">{{> "artist-link"}}</p>
        <p class="card-meta dot-list">{{> "genre-year"}}</p>
    </div>
</article>
