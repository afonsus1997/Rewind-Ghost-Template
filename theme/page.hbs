{{!< default}}

{{#post}}
<article class="page {{post_class}}">
    {{#if @page.show_title_and_feature_image}}
    <header class="container page-head">
        <h1 class="page-title">{{title}}</h1>
        {{#if custom_excerpt}}<p class="review-lede">{{custom_excerpt}}</p>{{/if}}
    </header>
    {{#if feature_image}}
        <figure class="container page-image">
            <img src="{{img_url feature_image size="xl"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}">
        </figure>
    {{/if}}
    {{/if}}
    <div class="container review-body">
        <div class="gh-content">
            {{content}}
        </div>
    </div>
</article>
{{/post}}
